# NexusDraw Backend — Environment Variables
# Copy this file to .env and adjust if needed.

# Server port (most hosts set this automatically)
PORT=3001

# Environment flag
NODE_ENV=development

# CORS origin for the frontend (defaults to http://localhost:5173 in dev)
# In production, set to your domain or leave unset for same-origin
# CORS_ORIGIN=https://nexusdraw.onrender.com
